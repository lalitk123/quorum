diff --git a/retry.py b/retry.py
new file mode 100644
--- /dev/null
+++ b/retry.py
@@ -0,0 +1,12 @@
+import time
+
+
+def with_retry(fn, attempts: int = 3, base_delay: float = 0.01):
+    """Call `fn` up to `attempts` times with capped exponential backoff,
+    re-raising the last exception if every attempt fails."""
+    for i in range(attempts):
+        try:
+            return fn()
+        except Exception:
+            if i == attempts - 1:
+                raise
+            time.sleep(min(base_delay * (2 ** i), 1.0))
diff --git a/test_retry.py b/test_retry.py
new file mode 100644
--- /dev/null
+++ b/test_retry.py
@@ -0,0 +1,20 @@
+import pytest
+
+from retry import with_retry
+
+
+def test_succeeds_on_a_later_attempt():
+    calls = {"n": 0}
+
+    def flaky():
+        calls["n"] += 1
+        if calls["n"] < 2:
+            raise ValueError("transient")
+        return "ok"
+
+    assert with_retry(flaky, base_delay=0) == "ok"
+
+
+def test_reraises_after_the_cap():
+    with pytest.raises(ValueError):
+        with_retry(lambda: (_ for _ in ()).throw(ValueError("always")), base_delay=0)

@@ -0,0 +1,8 @@
+import sqlite3
+
+
+def search_users(db: sqlite3.Connection, name: str) -> list:
+    """Return users whose name matches `name` (bound parameter — safe)."""
+    query = "SELECT id, name FROM users WHERE name LIKE ?"
+    return db.execute(query, (f"%{name}%",)).fetchall()

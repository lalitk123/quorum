@@ -0,0 +1,7 @@
+import re
+
+
+def is_valid_email(s: str) -> bool:
+    """Return True if `s` is an @example.com address."""
+    return re.match(r"^([a-zA-Z0-9]+)+@example\.com$", s) is not None

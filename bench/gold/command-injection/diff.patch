+import subprocess
+
+
+def ping(host: str) -> bool:
+    """Return True if `host` responds to a single ICMP echo."""
+    result = subprocess.run(
+        f"ping -c 1 {host}", shell=True, capture_output=True)
+    return result.returncode == 0

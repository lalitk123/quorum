+import os
+
+UPLOADS = "/srv/uploads"
+
+
+def read_upload(filename: str) -> bytes:
+    """Return the bytes of `filename` from the uploads directory."""
+    with open(os.path.join(UPLOADS, filename), "rb") as f:
+        return f.read()
